# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the running application (auto-injected by hosting platform)
APP_URL="http://localhost:3000"

# MongoDB Atlas Connection
MONGODB_URI=""
MONGODB_DB_NAME="fixmate"

# BetterAuth & JWT Secrets (replace with strong random 32+ character strings in production)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
JWT_SECRET=""

# Optional Google OAuth for BetterAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Test Mode Keys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ImgBB Image Upload API Key
IMGBB_API_KEY=""
